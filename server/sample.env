# Path where you want to store your files
HOME_CLOUD_STORAGE="/home/user/example"
# On windows: "C:\Users\user\example"

# Password required to access the cloud
HOME_CLOUD_PASSWORD="change-me"

# Optional: secret used to sign sessions. If not set, a random one is
# generated on startup and everyone has to log in again after a restart.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# HOME_CLOUD_SESSION_SECRET=""

# Optional: session duration in hours (default: 168, one week)
# HOME_CLOUD_SESSION_HOURS=168

# Optional: maximum size of each uploaded file in MB (default: 4096)
# HOME_CLOUD_MAX_UPLOAD_MB=4096
